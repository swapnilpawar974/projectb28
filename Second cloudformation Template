AWSTemplateFormatVersion: '2010-09-09'

Description: DailyKart Grocery Shopping Application - Mumbai Region

Parameters:

  AdminEmail:
    Description: Email address for DailyKart admin and SES verification
    Type: String
    AllowedPattern: '^[^\s@]+@[^\s@]+\.[^\s@]+$'

  KeyPairName:
    Description: Existing EC2 key pair in ap-south-1
    Type: AWS::EC2::KeyPair::KeyName

  VpcId:
    Description: VPC for DailyKart resources
    Type: AWS::EC2::VPC::Id

  EC2Subnet:
    Description: Public subnet for EC2
    Type: AWS::EC2::Subnet::Id

  ALBSubnet1:
    Description: First public subnet for Application Load Balancer
    Type: AWS::EC2::Subnet::Id

  ALBSubnet2:
    Description: Second public subnet for Application Load Balancer in a different AZ
    Type: AWS::EC2::Subnet::Id

  DBSubnet1:
    Description: First private database subnet
    Type: AWS::EC2::Subnet::Id

  DBSubnet2:
    Description: Second private database subnet in a different AZ
    Type: AWS::EC2::Subnet::Id

  HostedZoneId:
    Description: Existing Route 53 Hosted Zone ID for dailykarrt.online
    Type: AWS::Route53::HostedZone::Id

  DomainName:
    Description: Domain name for DailyKart
    Type: String
    Default: dailykarrt.online

  SSHLocation:
    Description: Your public IP address followed by /32
    Type: String
    AllowedPattern: '^([0-9]{1,3}\.){3}[0-9]{1,3}/32$'

  DBUsername:
    Description: RDS master username
    Type: String
    Default: dailykartadmin
    MinLength: 1
    MaxLength: 16
    AllowedPattern: '^[a-zA-Z][a-zA-Z0-9]*$'

  DBPassword:
    Description: RDS master password
    Type: String
    NoEcho: true
    MinLength: 8
    MaxLength: 41
    AllowedPattern: '^[a-zA-Z0-9!#$%^&*()_+=-]+$'


Resources:

  ############################################################
  # ALB SECURITY GROUP
  ############################################################

  DailyKartALBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for DailyKart Application Load Balancer
      VpcId: !Ref VpcId

      SecurityGroupIngress:

        # HTTP
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          CidrIp: 0.0.0.0/0

        # HTTPS
        - IpProtocol: tcp
          FromPort: 443
          ToPort: 443
          CidrIp: 0.0.0.0/0

      Tags:
        - Key: Name
          Value: DailyKart-ALB-SG


  ############################################################
  # EC2 SECURITY GROUP
  ############################################################

  DailyKartEC2SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for DailyKart EC2
      VpcId: !Ref VpcId

      SecurityGroupIngress:

        # SSH - only from your IP
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: !Ref SSHLocation

        # HTTP - only from ALB
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          SourceSecurityGroupId: !GetAtt DailyKartALBSecurityGroup.GroupId

      Tags:
        - Key: Name
          Value: DailyKart-EC2-SG


  ############################################################
  # RDS SECURITY GROUP
  ############################################################

  DailyKartRDSSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    DeletionPolicy: Retain

    Properties:
      GroupDescription: Allow MySQL access from DailyKart EC2 only
      VpcId: !Ref VpcId

      SecurityGroupIngress:

        # MySQL only from EC2
        - IpProtocol: tcp
          FromPort: 3306
          ToPort: 3306
          SourceSecurityGroupId: !GetAtt DailyKartEC2SecurityGroup.GroupId

      Tags:
        - Key: Name
          Value: DailyKart-RDS-SG


  ############################################################
  # S3 BUCKET
  ############################################################

  DailyKartS3Bucket:
    Type: AWS::S3::Bucket
    DeletionPolicy: Retain

    Properties:
      VersioningConfiguration:
        Status: Enabled

      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256


  ############################################################
  # COGNITO USER POOL
  ############################################################

  DailyKartUserPool:
    Type: AWS::Cognito::UserPool

    Properties:
      UserPoolName: DailyKartUsers

      AutoVerifiedAttributes:
        - email

      UsernameAttributes:
        - email

      Policies:
        PasswordPolicy:
          MinimumLength: 8
          RequireUppercase: true
          RequireLowercase: true
          RequireNumbers: true
          RequireSymbols: false


  ############################################################
  # COGNITO CLIENT
  ############################################################

  DailyKartUserPoolClient:
    Type: AWS::Cognito::UserPoolClient

    Properties:
      ClientName: DailyKartWebClient
      UserPoolId: !Ref DailyKartUserPool
      GenerateSecret: false

      ExplicitAuthFlows:
        - ALLOW_USER_SRP_AUTH
        - ALLOW_USER_PASSWORD_AUTH
        - ALLOW_REFRESH_TOKEN_AUTH


  ############################################################
  # SES EMAIL IDENTITY
  ############################################################

  DailyKartSESIdentity:
    Type: AWS::SES::EmailIdentity

    Properties:
      EmailIdentity: !Ref AdminEmail


  ############################################################
  # CLOUDWATCH LOG GROUP
  ############################################################

  DailyKartLogGroup:
    Type: AWS::Logs::LogGroup

    Properties:
      LogGroupName: /dailykart/application
      RetentionInDays: 14


  ############################################################
  # EC2 IAM ROLE
  ############################################################

  DailyKartEC2Role:
    Type: AWS::IAM::Role

    Properties:
      RoleName: !Sub DailyKartEC2Role-${AWS::StackName}

      AssumeRolePolicyDocument:
        Version: '2012-10-17'

        Statement:
          - Effect: Allow

            Principal:
              Service:
                - ec2.amazonaws.com

            Action:
              - sts:AssumeRole

      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/CloudWatchAgentServerPolicy

      Policies:

        ######################################################
        # S3 ACCESS
        ######################################################

        - PolicyName: DailyKartS3Access

          PolicyDocument:
            Version: '2012-10-17'

            Statement:

              - Effect: Allow

                Action:
                  - s3:ListBucket

                Resource: !GetAtt DailyKartS3Bucket.Arn

              - Effect: Allow

                Action:
                  - s3:GetObject
                  - s3:PutObject
                  - s3:DeleteObject

                Resource: !Sub '${DailyKartS3Bucket.Arn}/*'


        ######################################################
        # SES ACCESS
        ######################################################

        - PolicyName: DailyKartSESEmailAccess

          PolicyDocument:
            Version: '2012-10-17'

            Statement:

              - Effect: Allow

                Action:
                  - ses:SendEmail
                  - ses:SendRawEmail

                Resource: !Sub 'arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/${AdminEmail}'


  ############################################################
  # EC2 INSTANCE PROFILE
  ############################################################

  DailyKartInstanceProfile:
    Type: AWS::IAM::InstanceProfile

    Properties:
      Roles:
        - !Ref DailyKartEC2Role


  ############################################################
  # EC2 INSTANCE
  ############################################################

  DailyKartEC2:
    Type: AWS::EC2::Instance

    Properties:

      ImageId: '{{resolve:ssm:/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}}'

      InstanceType: t3.micro

      KeyName: !Ref KeyPairName

      IamInstanceProfile: !Ref DailyKartInstanceProfile

      NetworkInterfaces:

        - AssociatePublicIpAddress: true

          DeviceIndex: '0'

          SubnetId: !Ref EC2Subnet

          GroupSet:
            - !GetAtt DailyKartEC2SecurityGroup.GroupId

      Tags:

        - Key: Name
          Value: DailyKart-EC2

      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash

          dnf update -y

          dnf install -y amazon-cloudwatch-agent

          mkdir -p /opt/aws/amazon-cloudwatch-agent/etc

          cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'
          {
            "logs": {
              "logs_collected": {
                "files": {
                  "collect_list": [
                    {
                      "file_path": "/var/log/messages",
                      "log_group_name": "/dailykart/application",
                      "log_stream_name": "ec2-system"
                    },
                    {
                      "file_path": "/var/log/cloud-init-output.log",
                      "log_group_name": "/dailykart/application",
                      "log_stream_name": "ec2-userdata"
                    }
                  ]
                }
              }
            }
          }
          EOF

          systemctl enable amazon-cloudwatch-agent

          systemctl start amazon-cloudwatch-agent


  ############################################################
  # RDS SUBNET GROUP
  ############################################################

  DailyKartDBSubnetGroup:
    Type: AWS::RDS::DBSubnetGroup
    DeletionPolicy: Retain

    Properties:
      DBSubnetGroupDescription: DailyKart MySQL subnet group

      SubnetIds:
        - !Ref DBSubnet1
        - !Ref DBSubnet2


  ############################################################
  # RDS MYSQL DATABASE
  ############################################################

  DailyKartRDS:
    Type: AWS::RDS::DBInstance

    DeletionPolicy: Retain
    UpdateReplacePolicy: Retain

    Properties:

      DBInstanceClass: db.t3.micro

      Engine: mysql

      AllocatedStorage: '20'

      StorageType: gp3

      DBName: dailykart

      MasterUsername: !Ref DBUsername

      MasterUserPassword: !Ref DBPassword

      VPCSecurityGroups:
        - !GetAtt DailyKartRDSSecurityGroup.GroupId

      DBSubnetGroupName: !Ref DailyKartDBSubnetGroup

      PubliclyAccessible: false

      MultiAZ: false

      BackupRetentionPeriod: 1

      StorageEncrypted: true

      AutoMinorVersionUpgrade: true


  ############################################################
  # ACM SSL CERTIFICATE
  ############################################################

  DailyKartCertificate:
    Type: AWS::CertificateManager::Certificate

    Properties:

      DomainName: !Ref DomainName

      ValidationMethod: DNS

      DomainValidationOptions:

        - DomainName: !Ref DomainName
          HostedZoneId: !Ref HostedZoneId

      Tags:
        - Key: Name
          Value: DailyKart-SSL


  ############################################################
  # APPLICATION LOAD BALANCER
  ############################################################

  DailyKartLoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer

    Properties:

      Name: DailyKart-ALB

      Scheme: internet-facing

      Type: application

      SecurityGroups:
        - !GetAtt DailyKartALBSecurityGroup.GroupId

      Subnets:
        - !Ref ALBSubnet1
        - !Ref ALBSubnet2

      Tags:
        - Key: Name
          Value: DailyKart-ALB


  ############################################################
  # ALB TARGET GROUP
  ############################################################

  DailyKartTargetGroup:
    Type: AWS::ElasticLoadBalancingV2::TargetGroup

    Properties:

      Name: DailyKart-TargetGroup

      Port: 80

      Protocol: HTTP

      TargetType: instance

      VpcId: !Ref VpcId

      HealthCheckEnabled: true

      HealthCheckProtocol: HTTP

      HealthCheckPort: traffic-port

      HealthCheckPath: /

      HealthyThresholdCount: 2

      UnhealthyThresholdCount: 3

      HealthCheckTimeoutSeconds: 5

      HealthCheckIntervalSeconds: 30

      Targets:

        - Id: !Ref DailyKartEC2
          Port: 80


  ############################################################
  # HTTP LISTENER
  # HTTP -> HTTPS REDIRECT
  ############################################################

  DailyKartHTTPListener:
    Type: AWS::ElasticLoadBalancingV2::Listener

    Properties:

      LoadBalancerArn: !Ref DailyKartLoadBalancer

      Port: 80

      Protocol: HTTP

      DefaultActions:

        - Type: redirect

          RedirectConfig:

            Protocol: HTTPS

            Port: '443'

            StatusCode: HTTP_301


  ############################################################
  # HTTPS LISTENER
  ############################################################

  DailyKartHTTPSListener:
    Type: AWS::ElasticLoadBalancingV2::Listener

    DependsOn:
      - DailyKartCertificate

    Properties:

      LoadBalancerArn: !Ref DailyKartLoadBalancer

      Port: 443

      Protocol: HTTPS

      Certificates:

        - CertificateArn: !Ref DailyKartCertificate

      SslPolicy: ELBSecurityPolicy-TLS13-1-2-2021-06

      DefaultActions:

        - Type: forward

          TargetGroupArn: !Ref DailyKartTargetGroup


  ############################################################
  # ROUTE 53 DNS RECORD
  ############################################################

  DailyKartDNSRecord:
    Type: AWS::Route53::RecordSet

    Properties:

      HostedZoneId: !Ref HostedZoneId

      Name: !Ref DomainName

      Type: A

      AliasTarget:

        DNSName: !GetAtt DailyKartLoadBalancer.DNSName

        HostedZoneId: !GetAtt DailyKartLoadBalancer.CanonicalHostedZoneID

        EvaluateTargetHealth: true


Outputs:

  ############################################################
  # EC2 OUTPUTS
  ############################################################

  EC2PublicIP:
    Description: DailyKart EC2 Public IP
    Value: !GetAtt DailyKartEC2.PublicIp

  EC2PublicDNS:
    Description: DailyKart EC2 Public DNS
    Value: !GetAtt DailyKartEC2.PublicDnsName


  ############################################################
  # ALB OUTPUTS
  ############################################################

  LoadBalancerDNS:
    Description: DailyKart Application Load Balancer DNS
    Value: !GetAtt DailyKartLoadBalancer.DNSName

  DailyKartURL:
    Description: DailyKart HTTPS website URL
    Value: !Sub 'https://${DomainName}'


  ############################################################
  # S3 OUTPUT
  ############################################################

  S3BucketName:
    Description: DailyKart grocery image bucket
    Value: !Ref DailyKartS3Bucket


  ############################################################
  # RDS OUTPUTS
  ############################################################

  RDSDatabaseEndpoint:
    Description: MySQL database endpoint
    Value: !GetAtt DailyKartRDS.Endpoint.Address

  RDSPort:
    Description: MySQL port
    Value: !GetAtt DailyKartRDS.Endpoint.Port


  ############################################################
  # COGNITO OUTPUTS
  ############################################################

  CognitoUserPoolID:
    Description: Cognito User Pool ID
    Value: !Ref DailyKartUserPool

  CognitoClientID:
    Description: Cognito App Client ID
    Value: !Ref DailyKartUserPoolClient


  ############################################################
  # CLOUDWATCH OUTPUT
  ############################################################

  CloudWatchLogGroup:
    Description: CloudWatch log group
    Value: !Ref DailyKartLogGroup


  ############################################################
  # SES OUTPUT
  ############################################################

  SESAdminEmail:
    Description: SES identity email
    Value: !Ref AdminEmail


  ############################################################
  # SSL OUTPUT
  ############################################################

  SSLCertificate:
    Description: ACM SSL Certificate ARN
    Value: !Ref DailyKartCertificate
    